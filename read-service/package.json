{
	"name": "read-service",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "nodemon --legacy-watch ./bin/www",
		"start": "node ./bin/www",
		"test": "jest --listTests && jest --detectOpenHandles --verbose",
		"lint": "eslint ."
	},
	"dependencies": {
		"amqplib": "^0.10.4",
		"cookie-parser": "~1.4.4",
		"debug": "~2.6.9",
		"express": "~4.16.1",
		"mongoose": "^8.3.3",
		"morgan": "~1.9.1",
		"pug": "^3.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@shelf/jest-mongodb": "^6.0.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.0",
		"globals": "^17.5.0",
		"jest": "^30.0.0",
		"nodemon": "^3.1.14",
		"supertest": "^7.1.0",
		"supports-color": "^9.4.0"
	},
	"jest": {
		"preset": "@shelf/jest-mongodb",
		"testEnvironment": "node",
		"transform": {},
		"testMatch": [
			"**/__tests__/**/*.test.js"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/"
		]
	}
}
